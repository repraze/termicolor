# Termicolor for git-delta - generated by https://github.com/repraze/termicolor
# Needs the termicolor-dark / termicolor-light bat themes installed (bat cache --build).

[delta "termicolor-dark"]
    dark = true
    syntax-theme = termicolor-dark
    file-style = bold "#bb7aff"
    file-decoration-style = "#404040" ul
    file-added-label = [+]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [>]
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#404040" box
    hunk-header-file-style = "#4d91ff"
    hunk-header-line-number-style = "#a3a3a3"
    commit-style = "#f2c224"
    commit-decoration-style = "#404040" box ul
    zero-style = syntax
    minus-style = syntax "#362125"
    minus-non-emph-style = syntax "#362125"
    minus-emph-style = syntax "#6c303e"
    minus-empty-line-marker-style = syntax "#362125"
    plus-style = syntax "#213029"
    plus-non-emph-style = syntax "#213029"
    plus-emph-style = syntax "#2f5f4a"
    plus-empty-line-marker-style = syntax "#213029"
    whitespace-error-style = reverse "#ff4c82"
    line-numbers-minus-style = "#ff4c82"
    line-numbers-plus-style = "#35e0a3"
    line-numbers-zero-style = "#737373"
    line-numbers-left-style = "#404040"
    line-numbers-right-style = "#404040"
    blame-palette = "#171717" "#0a0a0a" "#262626"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ~
    merge-conflict-end-symbol = ~
    merge-conflict-ours-diff-header-style = bold "#f2c224"
    merge-conflict-ours-diff-header-decoration-style = "#404040" box
    merge-conflict-theirs-diff-header-style = bold "#4d91ff"
    merge-conflict-theirs-diff-header-decoration-style = "#404040" box
    # restyles git's --color-moved output (set diff.colorMoved = default)
    map-styles = \
        bold purple => syntax "#332a3f", \
        bold blue => syntax "#222d3f", \
        bold cyan => syntax "#24393b", \
        bold yellow => syntax "#3c3522"

[delta "termicolor-light"]
    light = true
    syntax-theme = termicolor-light
    file-style = bold "#974bdc"
    file-decoration-style = "#d4d4d4" ul
    file-added-label = [+]
    file-modified-label = [~]
    file-removed-label = [-]
    file-renamed-label = [>]
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#d4d4d4" box
    hunk-header-file-style = "#216de4"
    hunk-header-line-number-style = "#525252"
    commit-style = "#966a00"
    commit-decoration-style = "#d4d4d4" box ul
    zero-style = syntax
    minus-style = syntax "#ffe1e6"
    minus-non-emph-style = syntax "#ffe1e6"
    minus-emph-style = syntax "#fdafbe"
    minus-empty-line-marker-style = syntax "#ffe1e6"
    plus-style = syntax "#deece5"
    plus-non-emph-style = syntax "#deece5"
    plus-emph-style = syntax "#a8ccba"
    plus-empty-line-marker-style = syntax "#deece5"
    whitespace-error-style = reverse "#e00063"
    line-numbers-minus-style = "#e00063"
    line-numbers-plus-style = "#00825b"
    line-numbers-zero-style = "#737373"
    line-numbers-left-style = "#d4d4d4"
    line-numbers-right-style = "#d4d4d4"
    blame-palette = "#ffffff" "#fafafa" "#f5f5f5"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ~
    merge-conflict-end-symbol = ~
    merge-conflict-ours-diff-header-style = bold "#966a00"
    merge-conflict-ours-diff-header-decoration-style = "#d4d4d4" box
    merge-conflict-theirs-diff-header-style = bold "#216de4"
    merge-conflict-theirs-diff-header-decoration-style = "#d4d4d4" box
    # restyles git's --color-moved output (set diff.colorMoved = default)
    map-styles = \
        bold purple => syntax "#e9ddfb", \
        bold blue => syntax "#d3e3fd", \
        bold cyan => syntax "#d3e5e6", \
        bold yellow => syntax "#eae0d1"

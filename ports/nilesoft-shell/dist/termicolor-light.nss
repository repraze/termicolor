// Termicolor for Nilesoft Shell - generated by https://github.com/repraze/termicolor - do not edit.

theme
{
    name = "modern"
    dark = false
    background
    {
        color = #f5f5f5
        opacity = 100
        effect = 0
    }
    item
    {
        opacity = 100
        text
        {
            normal = #0a0a0a
            select = #0a0a0a
            normal.disabled = #a3a3a3
            select.disabled = #a3a3a3
        }
        back
        {
            select = #eedfff
            select.disabled = #e5e5e5
        }
        border
        {
            select = #eedfff
            select.disabled = #e5e5e5
        }
    }
    border
    {
        enabled = true
        size = 1
        color = #d4d4d4
        opacity = 100
    }
    shadow
    {
        enabled = true
        color = #00000026
        opacity = 100
    }
    separator
    {
        size = 1
        color = #d4d4d4
    }
    symbol
    {
        normal = #525252
        select = #0a0a0a
        normal.disabled = #a3a3a3
        select.disabled = #a3a3a3
    }
    image
    {
        enabled = true
        color = [#0a0a0a, #a331fb, #f5f5f5]
    }
}

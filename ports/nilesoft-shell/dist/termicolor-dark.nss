// Termicolor for Nilesoft Shell - generated by https://github.com/repraze/termicolor - do not edit.

theme
{
    name = "modern"
    dark = true
    background
    {
        color = #262626
        opacity = 100
        effect = 0
    }
    item
    {
        opacity = 100
        text
        {
            normal = #fafafa
            select = #fafafa
            normal.disabled = #525252
            select.disabled = #525252
        }
        back
        {
            select = #332a3f
            select.disabled = #303030
        }
        border
        {
            select = #332a3f
            select.disabled = #303030
        }
    }
    border
    {
        enabled = true
        size = 1
        color = #404040
        opacity = 100
    }
    shadow
    {
        enabled = true
        color = #00000080
        opacity = 100
    }
    separator
    {
        size = 1
        color = #404040
    }
    symbol
    {
        normal = #a3a3a3
        select = #fafafa
        normal.disabled = #525252
        select.disabled = #525252
    }
    image
    {
        enabled = true
        color = [#fafafa, #bb7aff, #262626]
    }
}

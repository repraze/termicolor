// Termicolor for Nilesoft Shell - generated by https://github.com/repraze/termicolor - do not edit.

theme
{
    name = "modern"
    dark = auto
    background
    {
        color = @if(sys.dark, #262626, #f5f5f5)
        opacity = 100
        effect = 0
    }
    item
    {
        opacity = 100
        text
        {
            normal = @if(sys.dark, #fafafa, #0a0a0a)
            select = @if(sys.dark, #fafafa, #0a0a0a)
            normal.disabled = @if(sys.dark, #525252, #a3a3a3)
            select.disabled = @if(sys.dark, #525252, #a3a3a3)
        }
        back
        {
            select = @if(sys.dark, #332a3f, #eedfff)
            select.disabled = @if(sys.dark, #303030, #e5e5e5)
        }
        border
        {
            select = @if(sys.dark, #332a3f, #eedfff)
            select.disabled = @if(sys.dark, #303030, #e5e5e5)
        }
    }
    border
    {
        enabled = true
        size = 1
        color = @if(sys.dark, #404040, #d4d4d4)
        opacity = 100
    }
    shadow
    {
        enabled = true
        color = @if(sys.dark, #00000080, #00000026)
        opacity = 100
    }
    separator
    {
        size = 1
        color = @if(sys.dark, #404040, #d4d4d4)
    }
    symbol
    {
        normal = @if(sys.dark, #a3a3a3, #525252)
        select = @if(sys.dark, #fafafa, #0a0a0a)
        normal.disabled = @if(sys.dark, #525252, #a3a3a3)
        select.disabled = @if(sys.dark, #525252, #a3a3a3)
    }
    image
    {
        enabled = true
        color = [@if(sys.dark, #fafafa, #0a0a0a), @if(sys.dark, #bb7aff, #a331fb), @if(sys.dark, #262626, #f5f5f5)]
    }
}

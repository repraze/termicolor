# Theme: Termicolor Light
# By: https://github.com/repraze/termicolor (generated - do not edit)

# Main background, empty for terminal default
theme[main_bg]="#ffffff"

# Main text color
theme[main_fg]="#0a0a0a"

# Title color for boxes
theme[title]="#0a0a0a"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a331fb"

# Background color of selected item in processes box
theme[selected_bg]="#e2c9ff"

# Foreground color of selected item in processes box
theme[selected_fg]="#0a0a0a"

# Color of inactive/disabled text
theme[inactive_fg]="#737373"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#525252"

# Background color of the percentage meters
theme[meter_bg]="#d4d4d4"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#007f87"

# CPU box outline color
theme[cpu_box]="#a331fb"

# Memory/disks box outline color
theme[mem_box]="#00835c"

# Net up/down box outline color
theme[net_box]="#bb5500"

# Processes box outline color
theme[proc_box]="#006af6"

# Box divider line and small boxes line color
theme[div_line]="#d4d4d4"

# Temperature graph colors
theme[temp_start]="#006af6"
theme[temp_mid]="#a331fb"
theme[temp_end]="#e20064"

# CPU graph colors
theme[cpu_start]="#00835c"
theme[cpu_mid]="#a16500"
theme[cpu_end]="#e20064"

# Mem/Disk free meter
theme[free_start]="#00835c"
theme[free_mid]="#2c9870"
theme[free_end]="#2c9870"

# Mem/Disk cached meter
theme[cached_start]="#006af6"
theme[cached_mid]="#3885ff"
theme[cached_end]="#3885ff"

# Mem/Disk available meter
theme[available_start]="#a16500"
theme[available_mid]="#bb5500"
theme[available_end]="#bb5500"

# Mem/Disk used meter
theme[used_start]="#d400ab"
theme[used_mid]="#e20064"
theme[used_end]="#e20064"

# Download graph colors
theme[download_start]="#006af6"
theme[download_mid]="#a331fb"
theme[download_end]="#d400ab"

# Upload graph colors
theme[upload_start]="#00835c"
theme[upload_mid]="#a16500"
theme[upload_end]="#bb5500"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#00835c"
theme[process_mid]="#a16500"
theme[process_end]="#e20064"

# Process list banner when paused
theme[proc_pause_bg]="#ff4c82"

# Process list banner when following a process

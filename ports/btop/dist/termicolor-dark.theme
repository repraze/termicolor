# Theme: Termicolor Dark
# By: https://github.com/repraze/termicolor (generated - do not edit)

# Main background, empty for terminal default
theme[main_bg]="#171717"

# Main text color
theme[main_fg]="#fafafa"

# Title color for boxes
theme[title]="#fafafa"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff4c82"

# Background color of selected item in processes box
theme[selected_bg]="#562b34"

# Foreground color of selected item in processes box
theme[selected_fg]="#fafafa"

# Color of inactive/disabled text
theme[inactive_fg]="#737373"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#a3a3a3"

# Background color of the percentage meters
theme[meter_bg]="#404040"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#2edfeb"

# CPU box outline color
theme[cpu_box]="#ff4c82"

# Memory/disks box outline color
theme[mem_box]="#35e0a3"

# Net up/down box outline color
theme[net_box]="#ff9243"

# Processes box outline color
theme[proc_box]="#4d91ff"

# Box divider line and small boxes line color
theme[div_line]="#404040"

# Temperature graph colors
theme[temp_start]="#4d91ff"
theme[temp_mid]="#bb7aff"
theme[temp_end]="#ff4c82"

# CPU graph colors
theme[cpu_start]="#35e0a3"
theme[cpu_mid]="#f2c224"
theme[cpu_end]="#ff4c82"

# Mem/Disk free meter
theme[free_start]="#35e0a3"
theme[free_mid]="#52f4b6"
theme[free_end]="#52f4b6"

# Mem/Disk cached meter
theme[cached_start]="#4d91ff"

; Termicolor - generated, do not edit. https://github.com/repraze/termicolor

[Theme]
DisplayName=Termicolor Light
SetLogonBackground=0

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\Termicolor\Light\termicolor-radial-4-light-3840x2160.jpg
TileWallpaper=0
; 10: fill, cropped to keep the aspect ratio
WallpaperStyle=10
Pattern=

[Control Panel\Desktop\WindowMetrics]

[Slideshow]
Interval=1800000
Shuffle=1
; every image directly in this folder, including ones added later
ImagesRootPath=%LOCALAPPDATA%\Microsoft\Windows\Themes\Termicolor\Light

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC4BB7AFF
SystemMode=Light
AppMode=Light
VisualStyleVersion=10

[MasterThemeSelector]
MTSM=RJSPBS

[Sounds]
; Windows Default
SchemeName=@%SystemRoot%\System32\mmres.dll,-800

[Control Panel\Cursors]
AppStarting=%SystemRoot%\cursors\aero_working.ani
Arrow=%SystemRoot%\cursors\aero_arrow.cur
Crosshair=
Hand=%SystemRoot%\cursors\aero_link.cur
Help=%SystemRoot%\cursors\aero_helpsel.cur
IBeam=
No=%SystemRoot%\cursors\aero_unavail.cur
NWPen=%SystemRoot%\cursors\aero_pen.cur
SizeAll=%SystemRoot%\cursors\aero_move.cur
SizeNESW=%SystemRoot%\cursors\aero_nesw.cur
SizeNS=%SystemRoot%\cursors\aero_ns.cur
SizeNWSE=%SystemRoot%\cursors\aero_nwse.cur
SizeWE=%SystemRoot%\cursors\aero_ew.cur
UpArrow=%SystemRoot%\cursors\aero_up.cur
Wait=%SystemRoot%\cursors\aero_busy.ani
DefaultValue=Windows Default
DefaultValue.MUI=@main.cpl,-1020
